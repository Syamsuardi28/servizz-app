APP_NAME="SERVIZZ Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database (tidak digunakan, tapi Laravel butuh config ini) ──
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=servizz_db
DB_USERNAME=root
DB_PASSWORD=

# ── Session ──
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ── SERVIZZ API ── (sesuaikan dengan URL backend Node.js Anda)
SERVIZZ_API_URL=https://servizz-api.vercel.app
